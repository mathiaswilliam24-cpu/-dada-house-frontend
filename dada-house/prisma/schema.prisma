generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  TECHNICIAN
  DISPATCHER
  SUPER_ADMIN
  MANAGER
  CUSTOMER_SERVICE_REP
}

enum AgentStatus {
  AVAILABLE
  BUSY
  ON_CALL
  AWAY
  BREAK
  OFFLINE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TechStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  WORKING
  COMPLETED
  CANCELED
  NEED_RESCHEDULE
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum PaymentMethod {
  CASH
  CARD
  ZELLE
  CHECK
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  INSTALLED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  phone              String?
  role               Role      @default(CLIENT)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Call center
  agentStatus          AgentStatus? @default(OFFLINE)
  agentStatusUpdatedAt DateTime?

  accounts     Account[]
  sessions     Session[]
  appointments Appointment[]
  reviews      Review[]

  technicianProfile      TechnicianProfile?
  technicianRoster       Technician?
  technicianLocations    TechnicianLocation[]
  technicianClockEntries TechnicianClockEntry[]
  properties             Property[]
  servicePlans           CustomerServicePlan[]
  warranties             Warranty[]
  orders                 Order[]
  pushSubscriptions      PushSubscription[]
  dispatchedAppointments Appointment[]          @relation("dispatcher")
  technicianAppointments Appointment[]          @relation("technician")
  estimates              Estimate[]             @relation("technicianEstimates")
  jobPhotos              JobPhoto[]
  jobPayments            JobPayment[]
  jobParts               JobPart[]
  inventoryRequests      InventoryRequest[]
  technicianClients      TechnicianClient[]     @relation("technicianClients")
  expenses               Expense[]
  expenseSubscription    ExpenseSubscription?

  // Call center
  calls          Call[]         @relation("agentCalls")
  sentMessages   Message[]
  sentEmails     EmailMessage[]
  readVoicemails Voicemail[]
  customerRecord Customer?
}

model TechnicianClient {
  id           String   @id @default(cuid())
  technicianId String
  name         String
  email        String?
  phone        String?
  mobile       String?
  address      String?
  city         String?
  state        String   @default("TX")
  zip          String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  technician User @relation("technicianClients", fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique
  userId            String?
  service           String
  subservice        String?
  name              String
  phone             String
  email             String
  address           String
  city              String            @default("Houston")
  zipCode           String            @default("")
  taxCounty         String?
  description       String?
  preferredDate     DateTime?
  preferredTime     String?
  status            AppointmentStatus @default(PENDING)
  notes             String?
  photos            String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  technicianId          String?
  dispatcherId          String?
  eta                   DateTime?
  techStatus            TechStatus?
  propertyId            String?
  stripePaymentIntentId String?
  signatureUrl          String?
  totalAmount           Float?
  approvedAt            DateTime?

  // New fields
  priority            JobPriority @default(NORMAL)
  isEmergency         Boolean     @default(false)
  diagnosticFee       Float?
  diagnosticFeeStatus String?
  adminNotes          String?
  source              String      @default("website")
  confirmationToken   String?     @unique
  confirmedAt         DateTime?

  // Call center — set going forward only, no backfill of historical rows
  customerId String?
  projectId  String?

  // Service operations / dispatch (set going forward)
  jobType          String? // MAINTENANCE | SERVICE | REPAIR | INSTALLATION | DUCT_CLEANING | REMODELING | OTHER
  jobCategory      String? // e.g. "AC Not Cooling", "Seasonal AC Tune-Up"
  customerType     String? // RESIDENTIAL | COMMERCIAL
  scheduledStart   DateTime? // dispatch board slot
  scheduledEnd     DateTime?
  estimatedMinutes Int?
  arrivalWindow    String? // customer-facing window, e.g. "10 AM - 12 PM"
  billingAddress   String?
  equipmentId      String?
  createdById      String?
  leadSource       String? // Google, Facebook, Referral, Repeat customer, Yard sign…
  lat              Float? // geocoded service address (travel estimates)
  lng              Float?

  assignments JobAssignment[]
  events      JobEvent[]

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  technician       User?             @relation("technician", fields: [technicianId], references: [id], onDelete: SetNull)
  dispatcher       User?             @relation("dispatcher", fields: [dispatcherId], references: [id], onDelete: SetNull)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  maintenanceVisit MaintenanceVisit?
  invoice          Invoice?
  notifications    NotificationLog[]
  maintenanceLogs  MaintenanceLog[]
  formSubmissions  FormSubmission[]
  calls            Call[]

  // New relations
  diagnosisForm     DiagnosisForm?
  serviceDiagnostic ServiceDiagnostic?
  systemStartup     SystemStartup?
  ventCleaning      VentCleaning?
  ductCleaning      DuctCleaning?
  jobPhotos         JobPhoto[]
  payments          JobPayment[]
  checklist         ServiceChecklist?
  timeLog           JobTimeLog?
  parts             JobPart[]
  hvacDiagnostics   HvacDiagnosticSession[]

  @@index([scheduledStart])
  @@index([technicianId, scheduledStart])
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  service   String?
  rating    Int
  content   String
  photos    String[] @default([])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  amount        Float
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  signatureUrl          String?
  stripePaymentIntentId String?
  dueDate               DateTime?
  lineItems             Json?
  paidAt                DateTime?

  // Loyalty points applied to this invoice
  loyaltyDiscount   Float @default(0)
  loyaltyPointsUsed Int   @default(0)

  // Payment flow
  paymentToken  String? @unique
  paymentMethod String? // ZELLE | CARD | CASH
  technicianId  String?
  sentByName    String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id            String   @id @default(cuid())
  appointmentId String
  type          String
  status        String
  recipient     String
  sentAt        DateTime @default(now())
  error         String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GalleryProject {
  id          String   @id @default(cuid())
  title       String
  category    String
  location    String
  date        String
  description String
  tags        String[] @default([])
  images      String[] @default([])
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Technician {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String
  role        String
  specialties String[] @default([])
  phone       String?
  email       String?
  photo       String?
  bio         String?
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TechnicianProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  vehicle       String?
  licenseNumber String?
  specialties   String[] @default([])
  availability  Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // New fields
  skills         String[] @default([])
  serviceAreas   String[] @default([])
  vehicleInfo    Json?
  certifications Json?
  photo          String?
  bio            String?

  // Dispatch
  employeeId         String?
  employmentType     String? // W2 | 1099
  techRole           String? // PRIMARY | LEAD_INSTALLER | HELPER | SUPERVISOR
  workingHours       Json? // { mon: { start: "08:00", end: "17:00" } | null, ... }
  emergencyAvailable Boolean @default(false)
  hourlyRate         Float?
  commissionRate     Float?
  boardColor         String?
  homeLat            Float? // start-of-day location for travel estimates
  homeLng            Float?
  homeAddress        String? // start-of-day address (geocoded into homeLat/homeLng)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TechnicianLocation {
  id        String   @id @default(cuid())
  userId    String
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

model TechnicianClockEntry {
  id        String   @id @default(cuid())
  userId    String
  type      String // "IN" | "OUT"
  timestamp DateTime @default(now())
  lat       Float?
  lng       Float?
  address   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

model Property {
  id        String   @id @default(cuid())
  userId    String
  address   String
  city      String
  state     String   @default("TX")
  zipCode   String
  type      String   @default("Residential")
  sqft      Int?
  yearBuilt Int?
  notes     String?
  equipment String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServicePlan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float
  interval        String
  features        String[] @default([])
  stripeProductId String?
  stripePriceId   String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerPlans CustomerServicePlan[]
}

model CustomerServicePlan {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  nextBilling          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Warranty {
  id            String    @id @default(cuid())
  appointmentId String?
  userId        String
  equipmentName String
  brand         String?
  model         String?
  serialNumber  String?
  installDate   DateTime?
  expiresAt     DateTime?
  documents     String[]  @default([])
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceLog {
  id            String   @id @default(cuid())
  appointmentId String?
  userId        String
  technicianId  String?
  notes         String?
  partsUsed     Json?
  laborHours    Float?
  photos        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model AIConversation {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String   @unique
  messages      Json     @default("[]")
  serviceType   String?
  urgency       String?
  ticketCreated Boolean  @default(false)
  appointmentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  price           Float
  comparePrice    Float?
  images          String[] @default([])
  videoUrl        String?
  category        String
  inStock         Boolean  @default(true)
  stockCount      Int?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  stripeProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?
  status                OrderStatus @default(PENDING)
  subtotal              Float
  tax                   Float       @default(0)
  shipping              Float       @default(0)
  total                 Float
  shippingAddress       Json?
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Installation fields
  installationFirstName String?
  installationLastName  String?
  installationAddress   String?
  installationCity      String?
  installationDate      DateTime?
  installationTime      String?
  appointmentId         String?   @unique
  technicianId          String?
  technicianName        String?
  jobComplete           Boolean   @default(false)
  adminConfirmed        Boolean   @default(false)
  installationPhotos    String[]  @default([])
  customerEmail         String?
  customerPhone         String?

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Float
  productName String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String?
  appointmentId         String?
  orderId               String?
  amount                Float
  currency              String   @default("usd")
  status                String
  stripePaymentIntentId String   @unique
  method                String?
  metadata              Json?
  createdAt             DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Estimate {
  id             String  @id @default(cuid())
  estimateNumber String  @unique
  technicianId   String?
  appointmentId  String?

  clientName    String
  clientEmail   String
  clientPhone   String?
  clientMobile  String?
  clientFax     String?
  clientAddress String?
  clientCity    String?
  clientState   String  @default("TX")
  clientZip     String?

  lineItems         Json    @default("[]")
  additionalDetails String?

  subtotal      Float   @default(0)
  taxType       String  @default("none")
  taxLabel      String?
  taxRate       Float   @default(0)
  taxInclusive  Boolean @default(false)
  discountType  String  @default("none")
  discountValue Float   @default(0)
  total         Float   @default(0)

  status           String    @default("OPEN")
  templateColor    String    @default("#1B3FA8")
  showFinancing    Boolean   @default(false)
  requestSignature Boolean   @default(true)
  signatureUrl     String?
  sentAt           DateTime?
  convertedAt      DateTime?
  invoiceId        String?

  // Invoice mode
  isInvoice     Boolean   @default(false)
  paymentToken  String?   @unique
  paymentMethod String? // ZELLE | CARD | CASH
  paidAt        DateTime?
  sentByName    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technician User? @relation("technicianEstimates", fields: [technicianId], references: [id], onDelete: SetNull)
}

model PriceBookItem {
  id            String  @id @default(cuid())
  industry      String
  category      String
  subcategory1  String?
  subcategory2  String?
  name          String
  description   String?
  price         Float   @default(0)
  cost          Float   @default(0)
  taxable       Boolean @default(true)
  unit          String?
  taskCode      String?
  onlineBooking Boolean @default(false)
  imageUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ─── Technician PWA Models ────────────────────────────────────────────────────

model DiagnosisForm {
  id                  String    @id @default(cuid())
  appointmentId       String    @unique
  technicianId        String?
  problemFound        String
  causeOfIssue        String?
  recommendedSolution String?
  requiredParts       Json?     @default("[]")
  laborNeeded         String?
  estimatedTime       String?
  safetyNotes         String?
  customerApproved    Boolean   @default(false)
  customerApprovedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Replaces DiagnosisForm as the technician-facing diagnosis flow (kept, not
// dropped, for historical rows). See lib/service-diagnostic-fields.ts for the
// per-service-type field catalog rendered against `sectionData`.
model ServiceDiagnostic {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  technicianId  String?

  serviceType              String // AIR_CONDITIONING | HEATING | PLUMBING | REMODELING | OTHER
  customerReportedIssue    String?
  arrivalTime              DateTime?
  diagnosticStartTime      DateTime?
  diagnosticCompletionTime DateTime?

  // Section 2 — Initial Site Inspection
  equipmentInspected       String?
  systemOperatingOnArrival String? // YES | NO | INTERMITTENTLY | NOT_APPLICABLE
  visibleDamage            Boolean?
  waterLeakPresent         String? // YES | NO | NA
  unusualNoise             String? // YES | NO | NA
  burningSmell             Boolean?
  immediateSafetyConcern   Boolean  @default(false)
  safetyConcernDescription String?

  // Sections 3-6 — service-type-specific technical readings, keyed by field id
  sectionData Json @default("{}")

  // Section 7 — Diagnostic Findings
  problemFound                String?
  rootCause                   String?
  evidenceSupportingDiagnosis String?
  affectedComponents          String?
  recommendedRepair           String?
  additionalRecommendations   String?

  // Section 8 — Parts & Materials
  partsRequired Json @default("[]")

  // Section 9 — Repair Urgency
  repairUrgency             String? // NORMAL | RECOMMENDED | URGENT | EMERGENCY
  canCustomerContinueUsing  String? // YES | NO | WITH_LIMITATIONS
  cannotContinueExplanation String?

  // Section 11 — Technician Final Diagnosis
  finalDiagnosis            String?
  recommendedCorrectiveWork String?
  estimatedRepairType       String? // MINOR_REPAIR | MAJOR_REPAIR | REPLACEMENT_RECOMMENDED | FURTHER_DIAGNOSTIC_REQUIRED | NO_REPAIR_REQUIRED
  systemStatusWhenLeaving   String? // OPERATING_NORMALLY | OPERATING_TEMPORARILY | NOT_OPERATIONAL | SHUT_DOWN_FOR_SAFETY | DIAGNOSTIC_ONLY

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Phase 2 — supervisor review workflow
  status               DiagnosticStatus @default(DRAFT)
  reviewedById         String?
  reviewedAt           DateTime?
  supervisorComment    String?
  customerReportSentAt DateTime?

  // Public, non-expiring token for the on-demand PDF view route — used to
  // text customers a link to their report when they have no email on file.
  reportToken String? @unique

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

enum DiagnosticStatus {
  DRAFT
  AWAITING_SUPERVISOR_REVIEW
  RETURNED
  ADDITIONAL_TESTING_REQUESTED
  APPROVED
}

// New-installation commissioning form — same supervisor-review shape as
// ServiceDiagnostic (see lib/system-startup-fields.ts for the field catalog),
// but review stays mandatory here (not simplified away like ServiceDiagnostic
// was) since a new install carries warranty/liability weight.
model SystemStartup {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  technicianId  String?

  // Section 1 — Job & Installation Information
  additionalTechnicians String?
  systemType            String?
  installationType      String?
  permitNumber          String?
  startupDateTime       DateTime?

  equipment             Json @default("[]")
  installationChecklist Json @default("[]")
  refrigerantCircuit    Json @default("{}")
  vacuumEvacuation      Json @default("{}")
  electricalReadings    Json @default("{}")
  airflowPerformance    Json @default("{}")
  drainTest             Json @default("[]")
  heatingStartup        Json @default("{}")
  thermostatControls    Json @default("[]")

  finalTestResults   Json    @default("{}")
  finalStartupResult String?
  failExplanation    String?

  technicianCertified    Boolean   @default(false)
  technicianSignatureUrl String?
  technicianCertifiedAt  DateTime?

  handoverChecklist    Json      @default("[]")
  customerSignatureUrl String?
  customerHandoverAt   DateTime?

  status               DiagnosticStatus @default(DRAFT)
  reviewedById         String?
  reviewedAt           DateTime?
  supervisorComment    String?
  customerReportSentAt DateTime?

  // Public, non-expiring token for the on-demand PDF view route — used to
  // text customers a link to their report when they have no email on file.
  reportToken String? @unique

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Air Duct Cleaning service line — two forms, self-service (no supervisor
// review, confirmed with the user): a light grille/register-only cleaning,
// and a full whole-system duct cleaning with vent/register-by-vent/register
// documentation. See lib/duct-cleaning-fields.ts for the field catalog.
model VentCleaning {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  technicianId  String?

  propertyType          String?
  totalVentsAuthorized  Int?
  supplyVentsAuthorized Int?
  returnVentsAuthorized Int?

  overallCondition      Json    @default("[]")
  overallConditionOther String?
  beforePhotos          Json    @default("[]")

  vents Json @default("[]")

  workPerformed                Json    @default("[]")
  additionalFindings           Json    @default("[]")
  additionalFindingsOther      String?
  recommendedAdditionalService String?

  totalVentsCleaned Int?
  completionStatus  String?
  technicianNotes   String?

  technicianSignatureUrl String?
  customerSignatureUrl   String?

  completedAt          DateTime?
  customerReportSentAt DateTime?
  reportToken          String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model DuctCleaning {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  technicianId  String?

  propertyType         String?
  systemsCount         Int?
  systemsServiced      Json    @default("[]")
  totalSupplyRegisters Int?
  totalReturnRegisters Int?
  ductMaterial         String?

  preCleaningInspection Json    @default("[]")
  contaminationObserved Json    @default("[]")
  contaminationOther    String?
  systemProblemsFound   Json    @default("[]")
  systemProblemsOther   String?
  technicianFindings    String?

  cleaningProcedure   Json    @default("[]")
  equipmentMethodUsed String?

  registers         Json @default("[]")
  componentCleaning Json @default("{}")

  additionalIssueFound        Boolean  @default(false)
