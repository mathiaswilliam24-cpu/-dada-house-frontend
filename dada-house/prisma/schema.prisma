// ─── Call Center Models (Phase 1) ──────────────────────────────────────────
// Phase 3, not modeled yet: CallParticipant (warm transfer/conference),
// CallQueue, IvrMenu, BusinessHours, Holiday — see docs/call-center.md.

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
  ASSISTED_LIVING
  PROPERTY_MANAGER
}

model Customer {
  id                String       @id @default(cuid())
  firstName         String
  lastName          String?
  phone             String       @unique // E.164, primary identity key
  secondaryPhone    String?
  email             String?
  address           String?
  city              String?      @default("Houston")
  state             String?      @default("TX")
  zipCode           String?
  customerType      CustomerType @default(RESIDENTIAL)
  preferredLanguage String?      @default("en")
  tags              String[]     @default([])
  notes             String?
  userId            String?      @unique
  stripeCustomerId  String?      @unique // Stripe customer holding the cards on file
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments         Appointment[]
  calls                Call[]
  voicemails           Voicemail[]
  messageThreads       MessageThread[]
  emailThreads         EmailThread[]
  doNotContact         DoNotContact?
  maintenanceContracts MaintenanceContract[]
  equipment            Equipment[]
  projects             Project[]
  loyaltyAccount       LoyaltyAccount?

  @@index([phone])
  @@index([email])
}

model Equipment {
  id           String    @id @default(cuid())
  customerId   String
  technicianId String?
  type         String // "HVAC", "Water Heater", "Furnace", etc.
  makeModel    String?
  serialNumber String?
  installDate  DateTime?
  age          String?
  location     String? // e.g. "Attic", "Backyard unit"
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Nameplate / manufacturer specifications (verified by the technician) — HVAC Diagnostic Pro.
  // Specs live here; field measurements live in HvacMeasurement.
  category        String? // see lib/hvac/catalog.ts EQUIPMENT_CATEGORIES
  manufacturer    String?
  modelNumber     String?
  indoorModel     String?
  capacityTons    Float?
  refrigerant     String? // key of lib/hvac/data/pt-tables.json
  meteringDevice  String? // TXV | EEV | PISTON | CAP_TUBE | UNKNOWN
  compressorType  String? // RECIP | SCROLL | ROTARY | INVERTER_SCROLL | INVERTER_ROTARY | SCREW | UNKNOWN
  compressorCount Int?
  circuits        Int?
  stages          String? // SINGLE | TWO | VARIABLE
  heatingType     String? // NONE | HEAT_PUMP | GAS | ELECTRIC | DUAL_FUEL | HYDRONIC
  ratedVoltage    String? // e.g. "208/230"
  phase           Int? // 1 | 3
  minVoltage      Float?
  maxVoltage      Float?
  rla             Float?
  lra             Float?
  mca             Float?
  mocp            Float?
  specs           Json? // other manufacturer data: charging targets, temp-rise range, capacitor ratings…
  specsVerifiedAt DateTime?

  customer        Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  hvacDiagnostics HvacDiagnosticSession[]

  @@index([customerId])
}

model Project {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  description String?
  status      String   @default("OPEN") // OPEN | COMPLETED | ON_HOLD | CANCELED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Installation projects (Service Operations phase 3)
  projectNumber    String?   @unique // IP-2026-0001
  kind             String    @default("INSTALLATION")
  stage            String    @default("LEAD") // see lib/projects.ts PROJECT_STAGES
  stageUpdatedAt   DateTime?
  address          String?
  city             String?
  zipCode          String?
  equipmentSummary String?
  contractAmount   Float?
  depositAmount    Float?
  permitNumber     String?
  targetDate       DateTime?
  salesRepId       String?
  leadInstallerId  String?
  createdById      String?

  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  events       ProjectEvent[]

  @@index([customerId])
  @@index([stage])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  type      String // CREATED | STAGE | NOTE | JOB | UPDATED
  message   String
  fromStage String?
  toStage   String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// One included tune-up of a maintenance membership (2 per contract year: spring AC + fall heating).
model MaintenanceVisit {
  id            String    @id @default(cuid())
  contractId    String
  customerId    String
  periodStart   DateTime // start of the contract year this visit belongs to
  visitNumber   Int // 1 or 2
  season        String // SPRING_AC | FALL_HEATING
  windowStart   DateTime
  windowEnd     DateTime // due by
  status        String    @default("DUE") // DUE | SCHEDULED | COMPLETED | SKIPPED
  appointmentId String?   @unique
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contract    MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([contractId, periodStart, visitNumber])
  @@index([status, windowEnd])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
  VOICEMAIL
}

enum CallDisposition {
  BOOKED_JOB
  EXISTING_JOB_UPDATE
  BILLING_QUESTION
  GENERAL_INQUIRY
  COMPLAINT
  WRONG_NUMBER
  SPAM
  VOICEMAIL_LEFT
  NO_ANSWER
  TRANSFERRED_TO_VAPI
  OTHER
}

model Call {
  id               String           @id @default(cuid())
  twilioCallSid    String           @unique
  direction        CallDirection
  fromNumber       String
  toNumber         String
  status           CallStatus       @default(RINGING)
  disposition      CallDisposition?
  dispositionNotes String?
  customerId       String?
  agentId          String?
  appointmentId    String?
  startedAt        DateTime         @default(now())
  answeredAt       DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // AI voice agent (Vapi/"Emma") — populated when a call is handled or overflowed to the AI
  vapiCallId     String? @unique
  aiSummary      String? @db.Text
  aiTranscript   String? @db.Text
  aiRecordingUrl String?
  aiEndedReason  String?

  // Twilio SIDs of the outbound legs ringing dispatchers for this inbound call (cancelled once one accepts)
  ringLegSids String[] @default([])

  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent       User?          @relation("agentCalls", fields: [agentId], references: [id], onDelete: SetNull)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recording   CallRecording?
  voicemail   Voicemail?

  @@index([customerId])
  @@index([agentId])
  @@index([status])
  @@index([startedAt])
}

model CallRecording {
  id                 String   @id @default(cuid())
  callId             String   @unique
  twilioRecordingSid String   @unique
  url                String
  durationSeconds    Int?
  createdAt          DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model Voicemail {
  id                 String    @id @default(cuid())
  callId             String?   @unique
  twilioRecordingSid String    @unique
  fromNumber         String
  toNumber           String
  url                String
  durationSeconds    Int?
  customerId         String?
  isRead             Boolean   @default(false)
  readAt             DateTime?
  readById           String?
  createdAt          DateTime  @default(now())

  call     Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  readBy   User?     @relation(fields: [readById], references: [id], onDelete: SetNull)
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
  RECEIVED
}

model MessageThread {
  id            String   @id @default(cuid())
  customerId    String?
  phoneNumber   String
  lastMessageAt DateTime @default(now())
  unreadCount   Int      @default(0)
  createdAt     DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([phoneNumber])
  @@index([lastMessageAt])
}

model Message {
  id         String           @id @default(cuid())
  threadId   String
  direction  MessageDirection
  body       String
  status     MessageStatus    @default(QUEUED)
  twilioSid  String?          @unique
  fromNumber String
  toNumber   String
  sentById   String?
  templateId String?
  mediaUrls  String[]         @default([])
  createdAt  DateTime         @default(now())

  thread   MessageThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy   User?            @relation(fields: [sentById], references: [id], onDelete: SetNull)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([twilioSid])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model DoNotContact {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  customerId  String?  @unique
  reason      String   @default("STOP_KEYWORD")
  optedOutAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailThread {
  id            String   @id @default(cuid())
  customerId    String?
  emailAddress  String
  subject       String?
  lastMessageAt DateTime @default(now())
  unreadCount   Int      @default(0)
  createdAt     DateTime @default(now())

  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([emailAddress])
  @@index([lastMessageAt])
}

model EmailMessage {
  id              String         @id @default(cuid())
  threadId        String
  direction       EmailDirection
  subject         String?
  body            String
  bodyHtml        String?
  fromAddress     String
  toAddress       String
  resendId        String?        @unique
  messageIdHeader String?
  sentById        String?
  attachmentUrls  String[]       @default([])
  createdAt       DateTime       @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy User?       @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([threadId])
}

/**
 * Short redirect links for SMS — keeps texted invoice/estimate links from
 * looking like a wall of text (raw URLs with a security token are long).
 */
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  targetUrl String
  createdAt DateTime @default(now())
}

/**
 * HVAC system type options for the Performance Plan Contract flow (Heat Pump,
 * Straight Cool, Package Unit, ...) — admin-managed so the list can grow.
 */
model SystemType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/**
 * A form the super admin configures (fields defined as JSON) — e.g. "Clean and
 * Check Forms → First Visit". Technicians fill it out per job.
 */
model FormTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique // matches the technician-app route, e.g. "clean-and-check-first-visit"
  name      String
  category  String? // grouping label shown in the admin list, e.g. "Clean and Check Forms"
  fields    Json     @default("[]") // [{ id, label, type, options?, required? }]
  items     Json     @default("[]") // [{ id, name, taskCode?, price }] — billable items attached to the form
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id            String   @id @default(cuid())
  templateId    String
  appointmentId String
  technicianId  String?
  values        Json     @default("{}") // { [fieldId]: value }
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Public, non-expiring token for the on-demand PDF view route — used to
  // text customers a link to their report when they have no email on file.
  reportToken String? @unique

  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([templateId, appointmentId])
}

model MaintenancePlanType {
  id                   String   @id @default(cuid())
  name                 String
  monthlyPrice         Float
  annualPrice          Float
  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?
  contractHtml         String   @db.Text
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contracts MaintenanceContract[]
}

enum MaintenanceContractStatus {
  SENT
  SIGNED
  PAID
  ACTIVE
  PAST_DUE
  CANCELLED
}

model MaintenanceContract {
  id                    String                    @id @default(cuid())
  customerId            String
  planTypeId            String
  token                 String                    @unique
  status                MaintenanceContractStatus @default(SENT)
  systemMakeModel       String?
  systemAge             String?
  numberOfSystems       Int                       @default(1)
  systemTypes           String[]                  @default([])
  agreementStartDate    DateTime?
  customerSignatureUrl  String?
  repName               String?
  signedAt              DateTime?
  billingInterval       String?
  autoRenew             Boolean                   @default(true)
  stripeSubscriptionId  String?
  stripePaymentIntentId String?
  paidAt                DateTime?
  sentById              String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  // Self-enrollment fields
  selfEnrolled            Boolean   @default(false)
  membershipNumber        String?   @unique
  stripeCustomerId        String?
  stripeCheckoutSessionId String?   @unique
  annualTotal             Float?
  monthlyTotal            Float?
  taxAmount               Float?
  firstName               String?
  lastName                String?
  email                   String?
  phone                   String?
  billingAddress          Json?
  preferredContact        String?
  preferredLanguage       String?   @default("en")
  marketingSmsConsent     Boolean   @default(false)
  marketingEmailConsent   Boolean   @default(false)
  agreementVersion        String?
  agreementAcceptedAt     DateTime?
  firstAppointmentAt      DateTime?
  firstAppointmentNotes   String?
  confirmationEmailSentAt DateTime?
  commitmentEndDate       DateTime?
  membershipStartDate     DateTime?
  renewalDate             DateTime?

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planType    MaintenancePlanType  @relation(fields: [planTypeId], references: [id])
  properties  ContractProperty[]
  hvacSystems ContractHvacSystem[]
  visits      MaintenanceVisit[]

  @@index([customerId])
  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
  @@index([membershipNumber])
}

model ContractProperty {
  id                 String   @id @default(cuid())
  contractId         String
  nickname           String?
  address            String
  apt                String?
  city               String
  state              String
  zipCode            String
  propertyType       String   @default("Residential")
  systemCount        Int      @default(1)
  accessInstructions String?
  gateCode           String?
  tenantName         String?
  tenantPhone        String?
  tenantEmail        String?
  createdAt          DateTime @default(now())

  contract MaintenanceContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  systems  ContractHvacSystem[]

  @@index([contractId])
}

model ContractHvacSystem {
  id              String   @id @default(cuid())
  contractId      String
  propertyId      String?
  nickname        String?
  coolingType     String?
  heatingType     String?
  brand           String?
  model           String?
  serialNumber    String?
  age             String?
  indoorLocation  String?
  outdoorLocation String?
  condition       String?
  unknownDetails  Boolean  @default(false)
  createdAt       DateTime @default(now())

  contract MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  property ContractProperty?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([propertyId])
}

// ── Loyalty Points System ──────────────────────────────────────────────────────

model LoyaltyAccount {
  id          String   @id @default(cuid())
  customerId  String   @unique
  balance     Int      @default(0) // current redeemable points
  totalEarned Int      @default(0) // lifetime points earned
  totalSpent  Int      @default(0) // lifetime points redeemed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  accountId   String
  type        String // EARN | REDEEM | ADJUSTMENT
  points      Int // positive = earn, negative = spend
  description String
  invoiceId   String?
  createdAt   DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Evidence log: every signature a customer gives on a technician's device, with
/// the exact statement they agreed to (used to answer card disputes/chargebacks).
model CustomerSignature {
  id                    String   @id @default(cuid())
  kind                  String // ESTIMATE_APPROVAL | PAYMENT_AUTHORIZATION | WORK_COMPLETION | PAYMENT_ACKNOWLEDGMENT
  estimateId            String?
  appointmentId         String?
  customerId            String?
  signerName            String
  signatureUrl          String
  statement             String
  amount                Float?
  cardBrand             String?
  cardLast4             String?
  stripePaymentIntentId String?
  collectedById         String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime @default(now())

  @@index([estimateId])
  @@index([appointmentId])
}

/// Every technician on a job (primary is mirrored in Appointment.technicianId for the technician app).
model JobAssignment {
  id            String   @id @default(cuid())
  appointmentId String
  technicianId  String
  role          String   @default("PRIMARY") // PRIMARY | LEAD_INSTALLER | HELPER | SUPERVISOR
  createdById   String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, technicianId])
  @@index([technicianId])
}

/// Audit trail of a job: created, scheduled, assigned, status changes, notes, forced overrides.
model JobEvent {
  id            String   @id @default(cuid())
  appointmentId String
  type          String // CREATED | SCHEDULED | ASSIGNED | UNASSIGNED | STATUS | TECH_STATUS | CANCELED | NOTE | FORCED
  message       String
  fromValue     String?
  toValue       String?
  userId        String?
  userName      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

/// Atomic sequential counters (e.g. call numbers DH-2026-000001).
model Counter {
  key   String @id
  value Int    @default(0)
}

// ── Stock locations (warehouse + one van per technician) ─────────────────────

model StockLocation {
  id           String   @id @default(cuid())
  name         String
  kind         String   @default("VAN") // WAREHOUSE | VAN
  technicianId String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  levels StockLevel[]
}

model StockLevel {
  id          String   @id @default(cuid())
  itemId      String
  locationId  String
  quantity    Float    @default(0)
  minQuantity Float    @default(0)
  updatedAt   DateTime @updatedAt

  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([locationId])
}

model StockMovement {
  id             String   @id @default(cuid())
  itemId         String
  type           String // RECEIVE | TRANSFER | USE | RETURN | ADJUST
  quantity       Float
  fromLocationId String?
  toLocationId   String?
  appointmentId  String?
  unitCost       Float?
  userId         String?
  userName       String?
  note           String?
  createdAt      DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([appointmentId])
  @@index([createdAt])
}

// ── HVAC Diagnostic Pro ───────────────────────────────────────────────────────
// One diagnostic visit on one piece of equipment. Calculations come from lib/hvac/engine.ts
// (deterministic, versioned); `results` is the last engine output, with the engine and
// PT-data versions recorded for traceability.
model HvacDiagnosticSession {
  id             String    @id @default(cuid())
  appointmentId  String?
  customerId     String?
  equipmentId    String?
  technicianId   String
  technicianName String?
  status         String    @default("DRAFT") // DRAFT | ANALYZED | COMPLETED
  step           Int       @default(1)
  complaint      String?
  complaintOther String?
  mode           String? // COOLING | HEATING_HP | HEATING_GAS | HEATING_ELECTRIC | DEFROST | AUX_HEAT | FAN_ONLY | NOT_RUNNING
  stage          String?
  circuits       Int       @default(1)
  equipment      Json      @default("{}") // verified spec snapshot used for this session's calculations
  safety         Json      @default("{}") // preliminary safety checks
  checks         Json      @default("{}") // system-specific observations
  results        Json?
  engineVersion  String?
  ptDataVersion  String?
  rulesetVersion String?
  decisions      Json      @default("{}") // technician confirm/reject per hypothesis id
  findings       Json      @default("{}") // verified findings, repairs performed, status on leaving, customer acknowledgment
  reportNumber   String?   @unique
  reportToken    String?   @unique
  notes          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  appointment  Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  equipmentRef Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  measurements HvacMeasurement[]
  safetyEvents HvacSafetyEvent[]
  scans        HvacScan[]

  @@index([technicianId, status])
  @@index([appointmentId])
  @@index([equipmentId])
  @@index([customerId])
}

// Every value keeps its canonical unit (°F, psig, V, A, µF, in. w.c., CFM…), what the technician
// actually typed (enteredValue/enteredUnit), where/how it was measured and by whom.
model HvacMeasurement {
  id           String   @id @default(cuid())
  sessionId    String
  circuit      Int      @default(1)
  key          String
  value        Float?
  text         String?
  unit         String?
  enteredValue Float?
  enteredUnit  String?
  location     String?
  mode         String?
  source       String   @default("MANUAL") // MANUAL | AI_PHOTO (read from a photo/video by AI, then verified by the technician) | INSTRUMENT
  instrument   String?
  technicianId String
  measuredAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session HvacDiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, circuit, key])
}

model HvacSafetyEvent {
  id           String   @id @default(cuid())
  sessionId    String
  code         String
  severity     String // CRITICAL | WARNING
  message      String
  technicianId String?
  createdAt    DateTime @default(now())

  session HvacDiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, code])
  @@index([severity, createdAt])
}

// Photos / video frames the technician uploads; AI vision proposes readings that the technician
// must verify before they are saved as measurements (source AI_PHOTO).
model HvacScan {
  id           String   @id @default(cuid())
  sessionId    String
  technicianId String
  imageUrls    Json // string[]
  kind         String   @default("PHOTO") // PHOTO | VIDEO_FRAMES
  model        String?
  status       String   @default("PENDING") // PENDING | APPLIED | DISCARDED | FAILED
  proposals    Json? // [{ target, key, circuit, value, unit, text, read, confidence, image }]
  notes        String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session HvacDiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
