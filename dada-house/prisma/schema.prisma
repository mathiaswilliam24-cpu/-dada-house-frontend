  partNumber  String?
  category    String?
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  unitCost    Float?
  supplier    String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

